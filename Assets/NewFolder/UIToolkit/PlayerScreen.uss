:root {
}

.list-text {
    font-size: 44px;
    margin-top: 32px;
    margin-right: 32px;
    margin-bottom: 32px;
    margin-left: 32px;
    -unity-font-style: bold;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    background-color: rgba(0, 0, 0, 0.18);
    padding-top: 25px;
    padding-right: 25px;
    padding-bottom: 25px;
    padding-left: 25px;
    color: rgb(255, 255, 255);
    text-overflow: ellipsis;
    white-space: nowrap;
    overflow: hidden;
}

.selected-label {
    background-color: rgba(73, 192, 44, 0.57);
}

.dotted-border {
    background-image: url("project://database/Assets/NewFolder/Textures/selection_dotted_border.png?fileID=2800000&guid=4f68b4ff693d48bc936edd921fefb886&type=3#selection_dotted_border");
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.selected-border {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 4px;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-left-width: 4px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.active-border {
    border-left-color: rgb(255, 202, 0);
    border-right-color: rgb(255, 202, 0);
    border-top-color: rgb(255, 202, 0);
    border-bottom-color: rgb(255, 202, 0);
}

.active-image {
    filter: tint(rgb(255, 232, 0));
}
